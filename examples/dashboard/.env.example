# Copy this file to .env.local for a single OpenAI-compatible relay.
# Vite loads .env.local automatically; never commit the real API key.

VITE_DASHBOARD_AGENT_RUNTIME=1
VITE_E2E=0

EASY_EDITOR_AGENT_GATEWAY_ENABLED=1
EASY_EDITOR_AGENT_BASE_URL=https://relay.example.com/v1
EASY_EDITOR_AGENT_API_KEY=replace-with-local-secret
EASY_EDITOR_AGENT_MODEL=gpt-4.1

# The browser needs only the non-secret model name. The provider defaults to "default".
VITE_DASHBOARD_AGENT_MODEL=${EASY_EDITOR_AGENT_MODEL}

# Local project-bound session. Vite injects it server-side only for loopback Gateway requests.
EASY_EDITOR_AGENT_SESSION_TOKEN=replace-with-a-random-local-session-token
EASY_EDITOR_AGENT_PROJECT_ID=replace-with-active-project-id

# Optional overrides:
# EASY_EDITOR_AGENT_PROVIDER_ID=relay-main
# VITE_DASHBOARD_AGENT_MODEL_PROVIDER_ID=relay-main
# EASY_EDITOR_AGENT_SESSION_COOKIE_NAME=easy-editor-agent-session
